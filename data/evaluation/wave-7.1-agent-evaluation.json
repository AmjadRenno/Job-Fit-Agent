{
  "dataset_version": "wave-7.1",
  "description": "End-to-end evaluation scenarios for the current agent after Wave 7, using only canonical profile documents as evidence sources.",
  "cases": [
    {
      "id": "simple-job-no-tool",
      "title": "Simple .NET match without tool use",
      "job_description": "We need a junior backend developer with C# and REST APIs. Strong testing fundamentals and a collaborative team fit are helpful.",
      "canonical_profile_sources": [
        "data/profile/skills.md",
        "data/profile/profile.md",
        "data/profile/experience.md"
      ],
      "expected_behavior": {
        "tool_required": false,
        "tool_name": null,
        "expected_outcome": "grounded_analysis_without_extra_search",
        "expected_claims": ["C#", "REST APIs", "Testing (xUnit, NUnit, Moq)"],
        "forbidden_claims": ["Kubernetes"],
        "expected_missing_requirements": []
      }
    },
